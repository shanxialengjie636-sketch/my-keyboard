body {
  font-family: sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
}

#output {
  width: 300px;
  height: 60px;
  font-size: 24px;
  margin-bottom: 20px;
  text-align: right;
  padding: 10px;
}

.keyboard {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  max-width: 320px;
}

.key-btn {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
}

/* ボタン画像サイズ調整 */
.key-btn img {
  width: 60px;
  height: 60px;
  object-fit: contain;
}

#clear-btn {
  padding: 10px 20px;
  font-size: 16px;
  cursor: pointer;
}
